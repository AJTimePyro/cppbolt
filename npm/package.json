{
	"name": "cppbolt",
	"version": "1.0.0",
	"description": "A C++ compiler targeting WebAssembly",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/AJTimePyro/cppbolt.git"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.browser.mjs",
	"types": "./dist/index.d.ts",
	"jsdelivr": "./dist/cppbolt.browser.js",
	"unpkg": "./dist/cppbolt.browser.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.browser.mjs",
			"node": "./dist/index.js",
			"default": "./dist/index.browser.mjs"
		},
		"./wasm/cppbolt.wasm": "./wasm/cppbolt.wasm"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser.ts --bundle --format=esm --platform=browser --outfile=dist/index.browser.mjs && esbuild src/script.ts --bundle --format=iife --global-name=CppBolt --platform=browser --outfile=dist/cppbolt.browser.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist/",
		"wasm/cppbolt.wasm",
		"README.md"
	],
	"funding": "https://github.com/sponsors/AJTimePyro"
}

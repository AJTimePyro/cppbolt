{
  "name": "cppbolt",
  "version": "1.0.0",
  "description": "A C++ compiler targeting WebAssembly",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AJTimePyro/cppbolt.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

{
	"name": "cppbolt",
	"version": "1.1.0",
	"description": "A C++ compiler targeting WebAssembly",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/AJTimePyro/cppbolt.git"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=18"
	},
	"jsdelivr": "./dist/cppbolt.browser.js",
	"unpkg": "./dist/cppbolt.browser.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.browser.mjs",
			"node": "./dist/index.js",
			"default": "./dist/index.browser.mjs"
		},
		"./browser": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.browser.mjs",
			"default": "./dist/index.browser.mjs"
		},
		"./wasm/cppbolt.wasm": "./wasm/cppbolt.wasm"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "node ../tests/test_npm_runner_options.js && node ../tests/test_npm_compile_and_run_async.js && node ../tests/test_npm_node_worker.js && node ../tests/test_npm_browser_build.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist/",
		"wasm/cppbolt.wasm",
		"README.md",
		"LICENSE"
	],
	"funding": "https://github.com/sponsors/AJTimePyro"
}

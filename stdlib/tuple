#ifndef _MINI_STL_TUPLE_
#define _MINI_STL_TUPLE_

#include <cstddef>
#include <utility>

namespace std {

template <typename... Ts>
class tuple;

template <>
class tuple<> {
public:
    tuple() {}
};

template <typename Head, typename... Tail>
class tuple<Head, Tail...> : public tuple<Tail...> {
public:
    Head head;

    tuple() : tuple<Tail...>(), head() {}
    explicit tuple(const Head& h, const Tail&... tail)
        : tuple<Tail...>(tail...), head(h) {}
    explicit tuple(Head&& h, Tail&&... tail)
        : tuple<Tail...>(static_cast<Tail&&>(tail)...), head(static_cast<Head&&>(h)) {}

    template <typename UHead, typename... UTail>
    tuple(UHead&& h, UTail&&... tail)
        : tuple<Tail...>(static_cast<UTail&&>(tail)...), head(static_cast<UHead&&>(h)) {}
};

template <typename... Args>
tuple<Args...> make_tuple(Args... args) {
    return tuple<Args...>(args...);
}


template <size_t I, typename Tuple>
struct tuple_element;

template <typename Head, typename... Tail>
struct tuple_element<0, tuple<Head, Tail...>> {
    typedef Head type;
};

template <size_t I, typename Head, typename... Tail>
struct tuple_element<I, tuple<Head, Tail...>> : tuple_element<(I - 1), tuple<Tail...>> {};

template <size_t I, typename Tuple>
using tuple_element_t = typename tuple_element<I, Tuple>::type;


template <typename Tuple>
struct tuple_size;

template <typename... Ts>
struct tuple_size<tuple<Ts...>> {
    static const size_t value = sizeof...(Ts);
};


template <size_t I, typename Tuple>
struct tuple_getter;

template <typename Head, typename... Tail>
struct tuple_getter<0, tuple<Head, Tail...>> {
    static Head& get(tuple<Head, Tail...>& t) {
        return t.head;
    }
    static const Head& get(const tuple<Head, Tail...>& t) {
        return t.head;
    }
};

template <size_t I, typename Head, typename... Tail>
struct tuple_getter<I, tuple<Head, Tail...>> {
    static typename tuple_element<I, tuple<Head, Tail...>>::type&
    get(tuple<Head, Tail...>& t) {
        tuple<Tail...>& base = t;
        return tuple_getter<(I - 1), tuple<Tail...>>::get(base);
    }
    static const typename tuple_element<I, tuple<Head, Tail...>>::type&
    get(const tuple<Head, Tail...>& t) {
        const tuple<Tail...>& base = t;
        return tuple_getter<(I - 1), tuple<Tail...>>::get(base);
    }
};

template <size_t I, typename... Types>
typename tuple_element<I, tuple<Types...>>::type& get(tuple<Types...>& t) {
    return tuple_getter<I, tuple<Types...>>::get(t);
}

template <size_t I, typename... Types>
const typename tuple_element<I, tuple<Types...>>::type& get(const tuple<Types...>& t) {
    return tuple_getter<I, tuple<Types...>>::get(t);
}

template <size_t I, typename... Types>
typename tuple_element<I, tuple<Types...>>::type&& get(tuple<Types...>&& t) {
    return static_cast<typename tuple_element<I, tuple<Types...>>::type&&>(tuple_getter<I, tuple<Types...>>::get(t));
}

} // namespace std

#endif // _MINI_STL_TUPLE_

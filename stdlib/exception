#ifndef _LIBCPP_EXCEPTION
#define _LIBCPP_EXCEPTION

#include <compat/compiler/compiler.h>
#include <compat/runtime/runtime.h>
#include <cstddef>

_LIBCPP_BEGIN_NAMESPACE_STD

class _LIBCPP_EXPORTED_FROM_ABI exception {
public:
  _LIBCPP_HIDE_FROM_ABI exception() _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI virtual ~exception() _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI exception(const exception&) _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI exception& operator=(const exception&) _NOEXCEPT { return *this; }

  _LIBCPP_HIDE_FROM_ABI virtual const char* what() const _NOEXCEPT {
    return "std::exception";
  }
};

class _LIBCPP_EXPORTED_FROM_ABI bad_exception : public exception {
public:
  _LIBCPP_HIDE_FROM_ABI bad_exception() _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI virtual ~bad_exception() _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI bad_exception(const bad_exception&) _NOEXCEPT : exception() {}
  _LIBCPP_HIDE_FROM_ABI bad_exception& operator=(const bad_exception&) _NOEXCEPT { return *this; }

  _LIBCPP_HIDE_FROM_ABI virtual const char* what() const _NOEXCEPT {
    return "std::bad_exception";
  }
};

typedef void (*terminate_handler)();

_LIBCPP_HIDE_FROM_ABI inline terminate_handler& __terminate_handler_storage() _NOEXCEPT {
  static terminate_handler __handler = nullptr;
  return __handler;
}

_LIBCPP_HIDE_FROM_ABI inline terminate_handler get_terminate() _NOEXCEPT {
  terminate_handler __h = __terminate_handler_storage();
  return __h ? __h : abort;
}

_LIBCPP_HIDE_FROM_ABI inline terminate_handler set_terminate(terminate_handler __h) _NOEXCEPT {
  terminate_handler __old = get_terminate();
  __terminate_handler_storage() = __h;
  return __old;
}

_LIBCPP_NORETURN _LIBCPP_HIDE_FROM_ABI inline void terminate() _NOEXCEPT {
  terminate_handler __h = __terminate_handler_storage();
  if (__h) {
    try {
      __h();
    } catch (...) {
      // ISO C++17 [except.terminate]: if a terminate handler exits by throwing an exception, std::terminate calls abort
    }
  }
  abort();
}

_LIBCPP_HIDE_FROM_ABI inline bool uncaught_exception() _NOEXCEPT {
  return false;
}

_LIBCPP_HIDE_FROM_ABI inline int uncaught_exceptions() _NOEXCEPT {
  return 0;
}

_LIBCPP_END_NAMESPACE_STD

#endif // _LIBCPP_EXCEPTION

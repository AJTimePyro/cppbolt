#ifndef _MINI_STL_STRING_
#define _MINI_STL_STRING_

#include <cstddef>
#include <stdlib.h>
#include <string.h>

namespace std {
    class string {
    private:
        char*  _data;
        size_t _size;
        size_t _cap;

        void _ensure_cap(size_t new_cap) {
            if (new_cap <= _cap) return;
            size_t alloc_cap = _cap == 0 ? 8 : _cap * 2;
            if (alloc_cap < new_cap) alloc_cap = new_cap;
            char* new_data = (char*)malloc(alloc_cap + 1);
            if (_data) {
                memcpy(new_data, _data, _size);
                free(_data);
            }
            new_data[_size] = '\0';
            _data = new_data;
            _cap = alloc_cap;
        }

    public:
        static const size_t npos = (size_t)-1;

        typedef char* iterator;
        typedef const char* const_iterator;

        string() : _data(nullptr), _size(0), _cap(0) {
            _ensure_cap(8);
            _data[0] = '\0';
        }

        string(const char* s) : _data(nullptr), _size(0), _cap(0) {
            if (s) {
                _size = strlen(s);
                _cap = _size < 8 ? 8 : _size;
                _data = (char*)malloc(_cap + 1);
                memcpy(_data, s, _size + 1);
            } else {
                _ensure_cap(8);
                _data[0] = '\0';
            }
        }

        string(const string& o) : _data(nullptr), _size(0), _cap(0) {
            _size = o._size;
            _cap = o._cap < 8 ? 8 : o._cap;
            _data = (char*)malloc(_cap + 1);
            if (o._data) {
                memcpy(_data, o._data, _size + 1);
            } else {
                _data[0] = '\0';
            }
        }

        string& operator=(const string& o) {
            if (this == &o) return *this;
            if (o._size > _cap) {
                free(_data);
                _cap = o._cap;
                _data = (char*)malloc(_cap + 1);
            }
            _size = o._size;
            if (o._data) {
                memcpy(_data, o._data, _size + 1);
            } else {
                _data[0] = '\0';
            }
            return *this;
        }

        string& operator=(const char* s) {
            size_t len = s ? strlen(s) : 0;
            if (len > _cap) {
                size_t new_cap = len < 8 ? 8 : len;
                char* new_data = (char*)malloc(new_cap + 1);
                if (s) {
                    memcpy(new_data, s, len + 1);
                } else {
                    new_data[0] = '\0';
                }
                if (_data) free(_data);
                _data = new_data;
                _cap = new_cap;
                _size = len;
            } else {
                _size = len;
                if (s) {
                    memmove(_data, s, len + 1);
                } else {
                    if (_data) _data[0] = '\0';
                }
            }
            return *this;
        }

        ~string() {
            if (_data) {
                free(_data);
                _data = nullptr;
            }
            _size = 0;
            _cap = 0;
        }

        size_t size() const { return _size; }
        size_t length() const { return _size; }
        bool empty() const { return _size == 0; }
        void clear() {
            _size = 0;
            if (_data) {
                _data[0] = '\0';
            }
        }
        const char* c_str() const { return _data ? _data : ""; }
        const char* data() const { return _data ? _data : ""; }

        char& operator[](size_t idx) { return _data[idx]; }
        const char& operator[](size_t idx) const { return _data[idx]; }

        iterator begin() { return _data; }
        iterator end() { return _data + _size; }
        const_iterator begin() const { return _data; }
        const_iterator end() const { return _data + _size; }

        void push_back(char c) {
            _ensure_cap(_size + 1);
            _data[_size++] = c;
            _data[_size] = '\0';
        }

        string& operator+=(const string& o) {
            size_t add_len = o._size;
            if (add_len == 0) return *this;
            if (_size + add_len > _cap) {
                size_t new_cap = (_cap == 0 ? 8 : _cap * 2);
                if (new_cap < _size + add_len) new_cap = _size + add_len;
                char* new_data = (char*)malloc(new_cap + 1);
                if (_data) {
                    memcpy(new_data, _data, _size);
                }
                if (o._data) {
                    memcpy(new_data + _size, o._data, add_len);
                }
                if (_data) free(_data);
                _data = new_data;
                _cap = new_cap;
                _size += add_len;
                _data[_size] = '\0';
                return *this;
            }
            if (o._data) {
                memcpy(_data + _size, o._data, add_len);
            }
            _size += add_len;
            _data[_size] = '\0';
            return *this;
        }

        string& operator+=(const char* s) {
            if (!s) return *this;
            size_t len = strlen(s);
            if (len == 0) return *this;
            if (_size + len > _cap) {
                size_t new_cap = (_cap == 0 ? 8 : _cap * 2);
                if (new_cap < _size + len) new_cap = _size + len;
                char* new_data = (char*)malloc(new_cap + 1);
                if (_data) {
                    memcpy(new_data, _data, _size);
                }
                memcpy(new_data + _size, s, len);
                if (_data) free(_data);
                _data = new_data;
                _cap = new_cap;
                _size += len;
                _data[_size] = '\0';
                return *this;
            }
            memcpy(_data + _size, s, len);
            _size += len;
            _data[_size] = '\0';
            return *this;
        }

        string& operator+=(char c) {
            push_back(c);
            return *this;
        }

        string& append(const string& str) {
            *this += str; return *this;
        }
        string& append(const char* s) {
            *this += s; return *this;
        }
        string& append(const char* s, size_t n) {
            if (!s || n == 0) return *this;
            if (_size + n > _cap) {
                size_t new_cap = (_cap == 0 ? 8 : _cap * 2);
                if (new_cap < _size + n) new_cap = _size + n;
                char* new_data = (char*)malloc(new_cap + 1);
                if (_data) memcpy(new_data, _data, _size);
                memcpy(new_data + _size, s, n);
                if (_data) free(_data);
                _data = new_data;
                _cap = new_cap;
                _size += n;
                _data[_size] = '\0';
                return *this;
            }
            memcpy(_data + _size, s, n);
            _size += n;
            _data[_size] = '\0';
            return *this;
        }
        string& append(size_t n, char c) {
            for (size_t i = 0; i < n; ++i) {
                push_back(c);
            }
            return *this;
        }

        int compare(const string& str) const {
            if (!_data && !str._data) return 0;
            return strcmp(c_str(), str.c_str());
        }
        int compare(const char* s) const {
            return strcmp(c_str(), s ? s : "");
        }

        string substr() const { return substr(0, (size_t)-1); }
        string substr(size_t pos) const { return substr(pos, (size_t)-1); }
        string substr(size_t pos, size_t len) const {
            if (pos > _size) return string();
            if (len == (size_t)-1 || pos + len > _size) {
                len = _size - pos;
            }
            string res;
            if (len > 0 && _data) {
                res._ensure_cap(len);
                memcpy(res._data, _data + pos, len);
                res._size = len;
                res._data[len] = '\0';
            }
            return res;
        }

        size_t find(const string& str) const { return find(str.c_str(), 0); }
        size_t find(const string& str, size_t pos) const { return find(str.c_str(), pos); }
        size_t find(const char* s) const { return find(s, 0); }
        size_t find(const char* s, size_t pos) const {
            if (!s) return npos;
            size_t slen = strlen(s);
            if (slen == 0) return pos <= _size ? pos : npos;
            if (pos + slen > _size) return npos;
            for (size_t i = pos; i + slen <= _size; ++i) {
                bool match = true;
                for (size_t j = 0; j < slen; ++j) {
                    if (_data[i + j] != s[j]) {
                        match = false;
                        break;
                    }
                }
                if (match) return i;
            }
            return npos;
        }
        size_t find(char c) const { return find(c, 0); }
        size_t find(char c, size_t pos) const {
            if (pos >= _size) return npos;
            for (size_t i = pos; i < _size; ++i) {
                if (_data[i] == c) return i;
            }
            return npos;
        }

        string& erase() { return erase(0, (size_t)-1); }
        string& erase(size_t pos) { return erase(pos, (size_t)-1); }
        string& erase(size_t pos, size_t len) {
            if (len == (size_t)-1 || pos + len > _size) {
                len = _size - pos;
            }
            for (size_t i = pos; i + len <= _size; ++i) {
                _data[i] = _data[i + len];
            }
            _size -= len;
            return *this;
        }
    };

    #ifdef __CPP_WASM__
    inline const size_t string::npos = (size_t)-1;
#endif

    inline string operator+(const string& lhs, const string& rhs) {
        string res = lhs;
        res += rhs;
        return res;
    }

    inline string operator+(const string& lhs, const char* rhs) {
        string res = lhs;
        res += rhs;
        return res;
    }

    inline string operator+(const char* lhs, const string& rhs) {
        string res(lhs);
        res += rhs;
        return res;
    }

    inline bool operator==(const string& lhs, const string& rhs) {
        if (lhs.size() != rhs.size()) return false;
        return strcmp(lhs.c_str(), rhs.c_str()) == 0;
    }

    inline bool operator==(const string& lhs, const char* rhs) {
        return strcmp(lhs.c_str(), rhs ? rhs : "") == 0;
    }

    inline bool operator==(const char* lhs, const string& rhs) {
        return strcmp(lhs ? lhs : "", rhs.c_str()) == 0;
    }

    inline bool operator!=(const string& lhs, const string& rhs) { return !(lhs == rhs); }
    inline bool operator!=(const string& lhs, const char* rhs) { return !(lhs == rhs); }
    inline bool operator!=(const char* lhs, const string& rhs) { return !(lhs == rhs); }

    inline bool operator<(const string& lhs, const string& rhs) {
        return strcmp(lhs.c_str(), rhs.c_str()) < 0;
    }
}

#endif

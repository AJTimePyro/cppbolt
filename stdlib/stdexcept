class _LIBCPP_EXPORTED_FROM_ABI logic_error : public exception {
private:
  string __msg_;
public:
  _LIBCPP_HIDE_FROM_ABI explicit logic_error(const string& __arg) : __msg_(__arg) {}
  _LIBCPP_HIDE_FROM_ABI explicit logic_error(const char* __arg) : __msg_(__arg ? __arg : "") {}
  _LIBCPP_HIDE_FROM_ABI logic_error(const logic_error& __other) _NOEXCEPT : exception(__other), __msg_(__other.__msg_) {}
  _LIBCPP_HIDE_FROM_ABI logic_error& operator=(const logic_error& __other) _NOEXCEPT {
    if (this != &__other) {
      exception::operator=(__other);
      __msg_ = __other.__msg_;
    }
    return *this;
  }
  _LIBCPP_HIDE_FROM_ABI virtual ~logic_error() _NOEXCEPT {}
  _LIBCPP_HIDE_FROM_ABI virtual const char* what() const _NOEXCEPT {
    return __msg_.c_str();
  }
};


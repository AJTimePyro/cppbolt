#ifndef _LIBCPP_TYPE_TRAITS
#define _LIBCPP_TYPE_TRAITS

// Adapted from LLVM libc++ 23.1.5 (llvmorg-23.1.5), libcxx/include/type_traits
// and its libcxx/include/__type_traits/*.h dependencies. The upstream umbrella
// header aggregates these components; only the C++17 traits supported by
// cppbolt are included here. See docs/stdlib/type_traits.md for the supported
// set, the compatibility shims and the known limitations.

#include <compat/compiler/compiler.h>
#include <detail/type_traits/builtins.h>

#include <detail/type_traits/integral_constant.h>
#include <detail/type_traits/enable_if.h>
#include <detail/type_traits/conditional.h>
#include <detail/type_traits/void_t.h>
#include <detail/type_traits/is_same.h>
#include <detail/type_traits/negation.h>

#include <detail/type_traits/remove_cv.h>
#include <detail/type_traits/remove_const.h>
#include <detail/type_traits/remove_volatile.h>
#include <detail/type_traits/add_cv_quals.h>
#include <detail/type_traits/remove_reference.h>
#include <detail/type_traits/add_reference.h>
#include <detail/type_traits/remove_pointer.h>
#include <detail/type_traits/add_pointer.h>
#include <detail/type_traits/decay.h>

#include <detail/type_traits/is_void.h>
#include <detail/type_traits/is_integral.h>
#include <detail/type_traits/is_floating_point.h>
#include <detail/type_traits/is_null_pointer.h>
#include <detail/type_traits/is_array.h>
#include <detail/type_traits/is_const.h>
#include <detail/type_traits/is_reference.h>
#include <detail/type_traits/is_pointer.h>
#include <detail/type_traits/is_member_pointer.h>
#include <detail/type_traits/is_arithmetic.h>
#include <detail/type_traits/is_fundamental.h>
#include <detail/type_traits/is_compound.h>
#include <detail/type_traits/is_signed.h>
#include <detail/type_traits/is_unsigned.h>
#include <detail/type_traits/make_signed.h>
#include <detail/type_traits/make_unsigned.h>

#include <detail/type_traits/rank.h>
#include <detail/type_traits/remove_extent.h>
#include <detail/type_traits/remove_all_extents.h>
#include <detail/type_traits/alignment_of.h>

#endif // _LIBCPP_TYPE_TRAITS

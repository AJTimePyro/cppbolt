#ifndef _MINI_STL_ALGORITHM_
#define _MINI_STL_ALGORITHM_

#include <cstddef>
#include <utility>
#include <detail/iterator.h>
#include <detail/algorithms/comp.h>
#include <detail/algorithms/min_max.h>
#include <detail/algorithms/heap.h>
#include <detail/algorithms/non_modifying.h>
#include <detail/algorithms/modifying.h>
#include <detail/algorithms/binary_search.h>
#include <detail/algorithms/partition.h>
#include <detail/algorithms/permutation.h>
#include <detail/algorithms/merge.h>
#include <detail/algorithms/set_ops.h>
#include <detail/algorithms/selection.h>
#include <detail/algorithms/random.h>

namespace std {

    namespace detail {
        template<typename Iter, typename Comp>
        void introsort_loop(Iter first, Iter last, int depth_limit, Comp comp) {
            ptrdiff_t count = last - first;
            if (count <= 16) {
                detail::__insertion_sort(first, last, comp);
                return;
            }
            if (depth_limit <= 0) {
                std::make_heap(first, last, comp);
                std::sort_heap(first, last, comp);
                return;
            }

            Iter mid = first + count / 2;
            auto pivot = *mid;

            Iter left = first;
            Iter right = last - 1;

            while (left <= right) {
                while (comp(*left, pivot)) ++left;
                while (comp(pivot, *right)) --right;
                if (left <= right) {
                    std::swap(*left, *right);
                    ++left;
                    --right;
                }
            }

            if (first < right + 1) introsort_loop(first, right + 1, depth_limit - 1, comp);
            if (left < last) introsort_loop(left, last, depth_limit - 1, comp);
        }

        inline int calc_depth_limit(ptrdiff_t n) {
            int depth = 0;
            while (n > 1) {
                depth++;
                n >>= 1;
            }
            return depth * 2;
        }
    }

    template<typename Iter>
    void sort(Iter first, Iter last) {
        if (first < last) {
            int depth = detail::calc_depth_limit(last - first);
            detail::introsort_loop(first, last, depth, detail::DefaultLess());
        }
    }

    template<typename Iter, typename Comp>
    void sort(Iter first, Iter last, Comp comp) {
        if (first < last) {
            int depth = detail::calc_depth_limit(last - first);
            detail::introsort_loop(first, last, depth, comp);
        }
    }
}

#endif
